# Copy to .env and adjust locally. Never commit real secrets or model binaries.

# "demo" uses reproducible synthetic data only; "real" requires operator-supplied
# IEEE-CIS transaction/identity files under FRAUD_DATA_DIR.
FRAUD_DATA_MODE=demo
FRAUD_DATA_DIR=data

# Trusted, operator-provisioned joblib artifact. joblib.load executes code:
# load artifacts ONLY from a source you own and trust.
FRAUD_MODEL_PATH=artifacts/candidate.joblib

# Decision cutoff stored with the model (0 < threshold < 1).
FRAUD_THRESHOLD=0.5
# max_f1 | min_precision | review_capacity | business_cost
FRAUD_THRESHOLD_STRATEGY=max_f1
# none | sigmoid | isotonic
FRAUD_CALIBRATION_METHOD=isotonic

# DEMO VALUE ONLY — change to a long random secret before exposing the API.
# Clients must send this in the X-API-Key header on scoring endpoints.
FRAUD_API_KEY=change-me-to-a-long-random-secret

# Maximum transactions accepted by POST /api/v1/predict/batch.
FRAUD_MAX_BATCH_SIZE=500

FRAUD_RANDOM_SEED=42
FRAUD_TRAIN_FRACTION=0.70
FRAUD_VALIDATION_FRACTION=0.15

# Optional experiment-tracking URI used by offline training tooling only.
FRAUD_MLFLOW_TRACKING_URI=file:./mlruns

# Comma-separated browser origins allowed by CORS. A wildcard "*" is rejected;
# credentials are only used with explicit localhost origins by default.
FRAUD_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8501,http://127.0.0.1:8501

# Base URL advertised to local dashboard clients (not a secret).
FRAUD_API_URL=http://localhost:8000
